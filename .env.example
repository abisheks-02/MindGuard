# ── App ─────────────────────────────────────────────────
APP_NAME=MindGuard AI Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DEMO_AUTH=true
ENABLE_MOCK_ESCALATION=true
# Keep false until explicit consent, retention, access, and deletion workflows
# are implemented and approved.
RETAIN_CHAT_CONTENT=false

# ── Database ────────────────────────────────────────────
# SQLite (dev):
DATABASE_URL=sqlite:///./mindguard.db
# PostgreSQL (prod):
# DATABASE_URL=postgresql://user:password@localhost:5432/mindguard

# ── CORS ────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ── Hugging Face ────────────────────────────────────────
HF_TOKEN=your_hf_token_here

# Replace these with values supplied by your secret manager in production.
SECRET_KEY=replace_me_with_a_random_secret
MINDGUARD_PRIVACY_SECRET=replace_me_with_a_random_privacy_secret

# ── Models ──────────────────────────────────────────────
LLAMA_MODEL_NAME=meta-llama/Llama-3.2-3B-Instruct
WHISPER_MODEL_NAME=openai/whisper-tiny
